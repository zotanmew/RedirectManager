@using System.Text.RegularExpressions
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">RedirectManager</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        @if (HttpContext?.Items.TryGetValue("authenticated", out var res) == true && res is true)
        {
            var homeMatch = HttpContext.Request.Path == "/" || Regex.IsMatch(HttpContext.Request.Path.Value ?? "", "^/[0-9]+$")
                ? NavLinkMatch.Prefix
                : NavLinkMatch.All;

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin" Match="homeMatch">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/new">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> New redirect
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/logout">
                    <span class="bi bi-door-closed-fill" aria-hidden="true"></span> Logout
                </NavLink>
            </div>
        }
        else
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/admin/login" Match="NavLinkMatch.All">
                    <span class="bi bi-door-closed-fill" aria-hidden="true"></span> Login
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
}